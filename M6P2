# M6P2 - Part unit cost and total cost

# Input
part_number = input("Enter part number: ").strip()
quantity = int(input("Enter quantity: "))

# Process
if part_number == "10" or part_number == "55":
    unit_cost = 1.00
elif part_number == "99":
    unit_cost = 2.00
elif part_number == "80" or part_number == "70":
    unit_cost = 3.00
else:
    unit_cost = 5.00

total_cost = quantity * unit_cost

# Output
print()
print(f"{'Part number:':<22}{part_number:>16}")
print(f"{'Cost per unit:':<22}${unit_cost:>15,.2f}")
print(f"{'Total cost:':<22}${total_cost:>15,.2f}")
