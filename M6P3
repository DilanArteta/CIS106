# M6P3 - CD interest rate and first-year interest

# Input
principal = float(input("Enter CD principal amount: "))
years = int(input("Enter years to maturity: "))

# Process
if principal > 100000 and years == 5:
    interest_rate = 0.06
elif principal >= 50000 and principal <= 100000:
    if years == 10:
        interest_rate = 0.05
    elif years == 5:
        interest_rate = 0.04
    else:
        interest_rate = 0.02
else:
    interest_rate = 0.02

first_year_interest = principal * interest_rate

# Output
print()
print(f"{'Principal:':<22}${principal:>15,.2f}")
print(f"{'Interest rate:':<22} {interest_rate * 100:>15.2f}%")
print(f"{'First-year interest:':<22}${first_year_interest:>15,.2f}")
