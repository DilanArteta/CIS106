# M6P5 - Employee bonus

# Input
last_name = input("Enter employee last name: ")
salary = float(input("Enter salary: "))
job_level = int(input("Enter job level: "))

# Process
if job_level >= 10:
    bonus_rate = 0.25
elif job_level >= 5 and job_level <= 9:
    bonus_rate = 0.20
else:
    bonus_rate = 0.10

bonus = salary * bonus_rate

# Output
print()
print(f"{'Employee last name:':<22}{last_name}")
print(f"{'Bonus:':<22}${bonus:>15,.2f}")
