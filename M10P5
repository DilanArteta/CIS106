# Module 10, Problem 5: Assessed home values
# Uses the classroom rates given in the assignment.

def compute_assessed_value(county, market_value):
    county = county.strip().lower()
    if county == "cook":
        percent = 0.90
    elif county == "dupage":
        percent = 0.80
    elif county == "mchenry":
        percent = 0.75
    elif county == "kane":
        percent = 0.60
    else:
        percent = 0.70
    return market_value * percent


def main():
    total_market_value = 0.0
    total_assessed_value = 0.0
    answer = input("Do you want to enter a home? (Yes or No): ").strip().lower()
    while answer == "yes":
        county = input("Enter county: ")
        market_value = float(input("Enter home market value: "))
        assessed_value = compute_assessed_value(county, market_value)
        print(f"County: {county}")
        print(f"Assessed value: ${assessed_value:,.2f}")
        total_market_value = total_market_value + market_value
        total_assessed_value = total_assessed_value + assessed_value
        answer = input("Do you want to enter another home? (Yes or No): ").strip().lower()
    print(f"Total market values: ${total_market_value:,.2f}")
    print(f"Total assessed values: ${total_assessed_value:,.2f}")


if __name__ == "__main__":
    main()